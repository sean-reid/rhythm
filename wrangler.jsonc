{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhythm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [{ "pattern": "rhythm.dwainosaur.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/s/*"],
  },
  "kv_namespaces": [{ "binding": "SHARES", "id": "767eec9824b041f997931e2794952e78" }],
  "ratelimits": [
    { "name": "SHARE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
